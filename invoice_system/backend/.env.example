# Copy to .env and adjust values
DATABASE_URL=sqlite:///./invoice_system.db
UPLOAD_DIR=./uploads
TESSERACT_CMD=tesseract
LOG_LEVEL=INFO

# LLM integration – required for /api/ai/qa endpoint
# Set LLM_PROVIDER to "claude" or "openai" and provide the matching API key.
LLM_PROVIDER=claude
LLM_API_KEY=
